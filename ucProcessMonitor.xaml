<UserControl x:Class="wpfTDX.ucProcessMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1900"  HorizontalAlignment="Stretch" 
             Background="LightGray">
    <StackPanel Margin="2" HorizontalAlignment="Stretch">
        <TextBlock Text="Process Monitor" FontSize="20" FontWeight="Bold" Margin="20 1 1 1"/>
        <WrapPanel x:Name="processWrapPanel"  
                       Orientation="Horizontal" Margin="5 1 5 5"
                        Width="1855"
                       HorizontalAlignment="Stretch"/>
    </StackPanel>
</UserControl>
