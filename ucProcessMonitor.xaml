<UserControl x:Class="wpfTDX.ucProcessMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="LightGray">
    <StackPanel Margin="2" >
        <TextBlock Text="Process Monitor" FontSize="20" FontWeight="Bold" Margin="20 1 1 1"/>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <WrapPanel x:Name="processWrapPanel"  Orientation="Horizontal" Margin="5 1"/>
        </Border>
    </StackPanel>
</UserControl>
