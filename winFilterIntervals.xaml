                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- base_d1: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="base__D1"
                    SelectedItemBinding="{Binding BaseD1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
