                                    <Setter Property="Background" Value="IndianRed"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding y1}" Value="False"/>
                                        <Condition Binding="{Binding PositionY1}" Value="1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
