                                    Binding="{Binding NumFiltIntervals}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="filt_deploy" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="FilteredDeployment"
                     StringFormat="{}{0:P1}"
                     TargetNullValue=""/>
                            </DataGridTextColumn.Binding>
                            <!-- (optional) right-align the text -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="new_trades" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="NewTrades" TargetNullValue=""/>
                    </DataGridTextColumn.Binding>

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- NewTrades < NumFilteredTrades → MistyRose -->
                                <DataTrigger Value="-1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareDoubleConverter}">
                                            <Binding Path="NewTrades"/>
                                            <Binding Path="NumFilteredTrades"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="MistyRose"/>
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </DataTrigger>

                                <!-- NewTrades > NumFilteredTrades → PaleGreen -->
                                <DataTrigger Value="1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareDoubleConverter}">
                                            <Binding Path="NewTrades"/>
                                            <Binding Path="NumFilteredTrades"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                </DataTrigger>

                                <!-- NewTrades == 0 → Grey (placed last so it takes precedence) -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="NewTrades" Converter="{StaticResource IsZeroConverter}"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="new_intvls" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="RescaledIntervals" TargetNullValue="" StringFormat="N0"/>
                    </DataGridTextColumn.Binding>

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>

                                <!-- rescaled < NumFiltIntervals  → MistyRose + DarkRed -->
                                <DataTrigger Value="-1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareDoubleConverter}">
                                            <Binding Path="RescaledIntervals"/>
                                            <Binding Path="NumFiltIntervals"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="MistyRose"/>
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </DataTrigger>

                                <!-- rescaled > NumFiltIntervals  → PaleGreen + DarkGreen -->
                                <DataTrigger Value="1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareDoubleConverter}">
                                            <Binding Path="RescaledIntervals"/>
                                            <Binding Path="NumFiltIntervals"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                </DataTrigger>

                                <!-- rescaled == null → Grey (most common "zero-like" case with your clamp) -->
                                <DataTrigger Binding="{Binding RescaledIntervals}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                    <Setter Property="Foreground" Value="{x:Null}"/>
                                </DataTrigger>

                                <!-- optional: rescaled == 0 → Grey (only if you ever allow 0) -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="RescaledIntervals" Converter="{StaticResource IsZeroConverter}"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                    <Setter Property="Foreground" Value="{x:Null}"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="new_deploy" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <!-- show as %, 1 decimal; show 0 if null or binding fails -->
                        <Binding Path="NewDeployment"
             StringFormat="{}{0:P1}"
             TargetNullValue="0"
             FallbackValue="0"/>
                    </DataGridTextColumn.Binding>

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>

                                <!-- less than baseline -->
                                <DataTrigger Value="-1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareRoundedConverter}" ConverterParameter="P1">
                                            <Binding Path="NewDeployment"/>
                                            <Binding Path="PositionDeployment"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="MistyRose"/>
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </DataTrigger>

                                <!-- greater than baseline -->
                                <DataTrigger Value="1">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource CompareRoundedConverter}" ConverterParameter="P1">
                                            <Binding Path="NewDeployment"/>
                                            <Binding Path="PositionDeployment"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                    <Setter Property="Foreground" Value="DarkGreen"/>
                                </DataTrigger>

                                <!-- zero (rounded to P1) -> keep text visible -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <Binding Path="NewDeployment"
                     Converter="{StaticResource IsZeroRoundedConverter}"
                     ConverterParameter="P1"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                    <!-- was Foreground={x:Null} which hid the text -->
                                    <Setter Property="Foreground"
                  Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                </DataTrigger>

                                <!-- Optional: if you still want to treat true null differently -->
                                <DataTrigger Binding="{Binding NewDeployment}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                    <Setter Property="Foreground"
                  Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>


            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
