<Window x:Class="wpfTDX.winFilterIntervals"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfTDX"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Adjust Intervals" Height="450" Width="1200"
        Loaded="Window_Loaded">

    <!-- Reusable resources -->
    <Window.Resources>
        <!-- One place for True/False options -->
        <x:Array x:Key="BoolOptions" Type="{x:Type sys:Boolean}">
            <sys:Boolean>True</sys:Boolean>
            <sys:Boolean>False</sys:Boolean>
        </x:Array>
        <local:IsZeroConverter x:Key="IsZeroConverter"/>
        <local:CompareDoubleConverter x:Key="CompareDoubleConverter"/>
        <local:CompareRoundedConverter x:Key="CompareRoundedConverter"/>
        <local:IsZeroRoundedConverter  x:Key="IsZeroRoundedConverter"/>
        <local:BoolToStringConverter x:Key="BoolToStringConverter"
                                 TrueText="True"
                                 FalseText="False"
                                 NullText="" />

        <Style x:Key="BusyButtonStyle" TargetType="Button">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>




    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0" >
            <Button Content="Reload Positions" Click="ReloadPositionsButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                ToolTip="Load TAD positions, then rebuild the merged view"/>
            <Button Content="Reload Filters" Click="ReloadFiltersButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                ToolTip="Load filter intervals, then rebuild the merged view"/>
            <Button Content="Reload Both" Click="ReloadBothButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                ToolTip="Load both data sources, then rebuild the merged view"/>
        </StackPanel>


        <DataGrid ItemsSource="{Binding MergedRows}"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="10"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  FrozenColumnCount="1"
                  PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick"
                  >

            <!-- Bold headers + show underscores literally -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- Using TextBlock so '_' isn't treated as an access key -->
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- Ticker (read-only) -->
                <DataGridTextColumn Header="tickername"
                                    Binding="{Binding Tickername}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="fundgrp"
                                    Binding="{Binding FundGroup}"
                                    IsReadOnly="True" />

                <!-- Rescale: dropdown True/False, bold when changed -->
                <DataGridTextColumn Header="rescale"
                                    IsReadOnly="True"
                 >
                    <DataGridTextColumn.Binding>
                        <Binding Path="Rescale" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RescaleHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- LongOnly -->
                <DataGridTextColumn Header="LO_only"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="LongOnly" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LongOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- ShortOnly -->
