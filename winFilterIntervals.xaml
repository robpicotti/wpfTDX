<Window x:Class="wpfTDX.winFilterIntervals"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfTDX"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Adjust Intervals" Height="450" Width="800"
        Loaded="Window_Loaded">

    <Grid>
        <DataGrid ItemsSource="{Binding MergedRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="10">

            <DataGrid.Columns>

                <!-- Ticker (read-only) -->
                <DataGridTextColumn Header="tickername"
                                    Binding="{Binding Tickername}"
                                    IsReadOnly="True" />

                <!-- Rescale: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="rescale"
                    SelectedItemBinding="{Binding Rescale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RescaleHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>


                <!-- LongOnly: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="long__only"
                    SelectedItemBinding="{Binding LongOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LongOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- ShortOnly: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="short__only"
                    SelectedItemBinding="{Binding ShortOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShortOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>
                <!-- BuyOnly: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="buy__only"
                    SelectedItemBinding="{Binding BuyOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuyOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- SellOnly: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="sell__only"
                    SelectedItemBinding="{Binding SellOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SellOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>
                <!-- add other columns here... -->
                <!-- AllIntervals: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="all__intervals"
                    SelectedItemBinding="{Binding AllIntervals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
