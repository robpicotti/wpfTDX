                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseD1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseD1}" Value="-1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MistyRose"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseD1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseD1}" Value="-1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="IndianRed"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseD1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseD1}" Value="1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- y1: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="y1"
                    SelectedItemBinding="{Binding y1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Y1HasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PositionY1}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </DataTrigger>
                                <!-- Light green when Y1 == true AND Positiony1 == 1 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
