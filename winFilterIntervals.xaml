<Window x:Class="wpfTDX.winFilterIntervals"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfTDX"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Adjust Intervals" Height="450" Width="1200"
        Loaded="Window_Loaded">

    <!-- Reusable resources -->
    <Window.Resources>
        <!-- One place for True/False options -->
        <x:Array x:Key="BoolOptions" Type="{x:Type sys:Boolean}">
            <sys:Boolean>True</sys:Boolean>
            <sys:Boolean>False</sys:Boolean>
        </x:Array>
    </Window.Resources>

    <Grid>
        <DataGrid ItemsSource="{Binding MergedRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="10"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  FrozenColumnCount="1">

            <!-- Bold headers + show underscores literally -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- Using TextBlock so '_' isn't treated as an access key -->
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- Ticker (read-only) -->
                <DataGridTextColumn Header="tickername"
                                    Binding="{Binding Tickername}"
                                    IsReadOnly="True" />

                <!-- Rescale: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="rescale"
                    ItemsSource="{StaticResource BoolOptions}"
                    SelectedItemBinding="{Binding Rescale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RescaleHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- LongOnly -->
                <DataGridComboBoxColumn Header="long_only"
                    ItemsSource="{StaticResource BoolOptions}"
                    SelectedItemBinding="{Binding LongOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LongOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- ShortOnly -->
                <DataGridComboBoxColumn Header="short_only"
                    ItemsSource="{StaticResource BoolOptions}"
                    SelectedItemBinding="{Binding ShortOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShortOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- BuyOnly -->
                <DataGridComboBoxColumn Header="buy_only"
                    ItemsSource="{StaticResource BoolOptions}"
                    SelectedItemBinding="{Binding BuyOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuyOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- SellOnly -->
