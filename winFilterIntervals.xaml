<Window x:Class="wpfTDX.winFilterIntervals"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfTDX"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Adjust Intervals" Height="450" Width="1200"
        Loaded="Window_Loaded">

    <!-- Reusable resources -->
    <Window.Resources>
        <!-- One place for True/False options -->
        <x:Array x:Key="BoolOptions" Type="{x:Type sys:Boolean}">
            <sys:Boolean>True</sys:Boolean>
            <sys:Boolean>False</sys:Boolean>
        </x:Array>
        <local:IsZeroConverter x:Key="IsZeroConverter"/>
        <local:CompareDoubleConverter x:Key="CompareDoubleConverter"/>
        <local:CompareRoundedConverter x:Key="CompareRoundedConverter"/>
        <local:IsZeroRoundedConverter  x:Key="IsZeroRoundedConverter"/>
        <local:BoolToStringConverter x:Key="BoolToStringConverter"
                                 TrueText="True"
                                 FalseText="False"
                                 NullText="" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="BusyButtonStyle" TargetType="Button">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>




    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Status: IsExecuting -->
            <RowDefinition Height="Auto"/>
            <!-- Status: Job -->
            <RowDefinition Height="*"/>
            <!-- Data grid -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0" >
            <Button Content="Reload Positions" Click="ReloadPositionsButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                     Margin="0,0,8,0"
                ToolTip="Load TAD positions, then rebuild the merged view"/>
            <Button Content="Reload Filters" Click="ReloadFiltersButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                     Margin="0,0,8,0"
                ToolTip="Load filter intervals, then rebuild the merged view"/>
            <Button Content="Reload Both" Click="ReloadBothButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                     Margin="0,0,8,0"
                ToolTip="Load both data sources, then rebuild the merged view"/>

            <Button Content="Reload Universe" Click="ReloadUniverseButton_Click"
                    Style="{StaticResource BusyButtonStyle}"
                    Padding="12,4" Margin="0,0,0,0"
                    ToolTip="Reload the cached ticker universe used by Add Ticker"/>
            <Separator Margin="10,0" Width="1" />

            <!-- Ticker filter -->
            <TextBlock Text="Ticker:" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <TextBox Width="160" Margin="0,0,8,0"
         ToolTip="Use * and ? wildcards (e.g. AAPL*, ?MSFT)"
         Text="{Binding TickerFilter, UpdateSourceTrigger=PropertyChanged,Delay=250}"/>

            <!-- FundGroup filter -->
            <TextBlock Text="Fund Group:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="160"
         ToolTip="Use * and ? wildcards"
         Text="{Binding FundGroupFilter, UpdateSourceTrigger=PropertyChanged,Delay=250}"/>

         <Button Content="Save Filter Intervals"
            Padding="12,4"
            Margin="8,0,0,0"
            Style="{StaticResource BusyButtonStyle}"
            ToolTip="Save current filters to the server"
            Click="Button_Click"
            IsEnabled="{Binding IsSaveEnabled}"
        />


        </StackPanel>

        <StatusBar Grid.Row="1">
            <TextBlock x:Name="StatusTextBlock" />
            <Separator Margin="6,0"/>
            <ProgressBar Width="120" Height="14"
                 IsIndeterminate="{Binding IsExecuting}"
                 Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StatusBar>
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" />
            <Separator Margin="6,0"/>
            <ProgressBar Width="140" Height="14"
                 Minimum="0" Maximum="100"
                 Value="{Binding ProgressPercent, Mode=OneWay}"
                 Visibility="{Binding IsUpsertRunning,
                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StatusBar>


        <DataGrid ItemsSource="{Binding MergedRowsView}"
                  x:Name="FilterGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="10"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.ScrollUnit="Item"
                         VirtualizingPanel.CacheLength="2"
                    VirtualizingPanel.CacheLengthUnit="Item"
                    EnableColumnVirtualization="True"
                  FrozenColumnCount="0"
                  PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick"
                  >

            <!-- Bold headers + show underscores literally -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- Using TextBlock so '_' isn't treated as an access key -->
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Resources>
                <!-- Row context menu -->
                <ContextMenu x:Key="RowContextMenu" x:Shared="False">
                    <MenuItem Header="Delete ticker" Click="DeleteTickerMenuItem_Click"/>
                    <MenuItem Header="Add ticker..." Click="AddTickerMenuItem_Click"/>
                </ContextMenu>

                <!-- Grid empty-area context menu -->
                <ContextMenu x:Key="GridContextMenu" x:Shared="False">
                    <MenuItem Header="Add ticker..." Click="AddTickerMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.Resources>

            <!-- Select the row under cursor on right-click -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                    <!-- Important: assign a *ContextMenu*, not a MenuItem -->
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                </Style>
            </DataGrid.RowStyle>

            <!-- Context menu for blank grid area -->
            <DataGrid.ContextMenu>
                <!-- Important: the root element must be ContextMenu -->
                <StaticResource ResourceKey="GridContextMenu"/>
            </DataGrid.ContextMenu>

