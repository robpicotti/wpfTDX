                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </DataTrigger>
                                <!-- Light green when BaseY1 == true AND PositionBaseH1 == 1 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseH1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseH1}" Value="1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="PaleGreen"/>
