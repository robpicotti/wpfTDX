<Window x:Class="wpfTDX.winFilterIntervals"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:globalization="clr-namespace:System.Globalization;assembly=mscorlib"
        xmlns:local="clr-namespace:wpfTDX"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Adjust Intervals" Height="450" Width="1200"
        Loaded="Window_Loaded">

    <!-- Reusable resources -->
    <Window.Resources>
        <!-- One place for True/False options -->
        <x:Array x:Key="BoolOptions" Type="{x:Type sys:Boolean}">
            <sys:Boolean>True</sys:Boolean>
            <sys:Boolean>False</sys:Boolean>
        </x:Array>
        <local:IsZeroConverter x:Key="IsZeroConverter"/>
        <local:CompareDoubleConverter x:Key="CompareDoubleConverter"/>
        <local:CompareRoundedConverter x:Key="CompareRoundedConverter"/>
        <local:IsZeroRoundedConverter  x:Key="IsZeroRoundedConverter"/>
        <local:NullableDoubleConverter x:Key="NullableDoubleConverter"/>
        <local:NullablePercentDoubleConverter x:Key="NullablePercentDoubleConverter"/>
        <local:BoolToStringConverter x:Key="BoolToStringConverter"
                                 TrueText="True"
                                 FalseText="False"
                                 NullText="" />
        <local:FlagTextOrBlankConverter x:Key="FlagTextOrBlankConverter" TrueText="True" FalseText="False"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="BusyButtonStyle" TargetType="Button">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:NotEqualConverter x:Key="NotEqualConverter"/>
        <SolidColorBrush x:Key="DiffFromDefaultBrush" Color="#B7E0FF"/>


    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="41*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Data grid -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>



        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Grid.ColumnSpan="2"  >
            <Button Content="Reload" Click="ReloadBothButton_Click" Padding="12,4"
                    Style="{StaticResource BusyButtonStyle}"
                     Margin="0,0,8,0"
                ToolTip="Load both data sources, then rebuild the merged view"/>

            <Button Content="Reload Universe" Click="ReloadUniverseButton_Click"
                    Style="{StaticResource BusyButtonStyle}"
                    Padding="12,4" Margin="0,0,0,0"
                    ToolTip="Reload the cached ticker universe used by Add Ticker"/>
            <Separator Margin="10,0" Width="1" />

            <!-- Ticker filter -->
            <TextBlock Text="Ticker:" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <TextBox Width="160" Margin="0,0,8,0"
         ToolTip="Use * and ? wildcards (e.g. AAPL*, ?MSFT)"
         Text="{Binding TickerFilter, UpdateSourceTrigger=PropertyChanged,Delay=250}"/>

            <!-- FundGroup filter -->
            <TextBlock Text="Fund Group:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="160"
         ToolTip="Use * and ? wildcards"
         Text="{Binding FundGroupFilter, UpdateSourceTrigger=PropertyChanged,Delay=250}"/>

            <Button Content="Save Filter Intervals"
            Padding="12,4"
            Margin="8,0,0,0"
            Style="{StaticResource BusyButtonStyle}"
            ToolTip="Save current filters to the server"
            Click="Button_Click"
            IsEnabled="{Binding IsSaveEnabled}"
        />


        </StackPanel>


        <StatusBar Grid.Row="2" Margin="10,6,10,10" Grid.ColumnSpan="2">
            <!-- Left: code-behind updates this (StatusTextBlock.Text) -->
            <TextBlock x:Name="StatusTextBlock" />

            <Separator Margin="6,0"/>

            <!-- Shows while vm.IsExecuting == true -->
            <ProgressBar Width="120" Height="14"
                 IsIndeterminate="{Binding IsExecuting}"
                 Visibility="{Binding IsExecuting,
                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Separator Margin="6,0"/>

            <!-- Optional: VM-driven status text (kept as-is; remove if you don’t want duplication) -->
            <TextBlock Text="{Binding StatusMessage}" />

            <Separator Margin="6,0"/>

            <!-- Quantitative progress from the background job -->
            <ProgressBar Width="140" Height="14"
                 Minimum="0" Maximum="100"
                 Value="{Binding ProgressPercent, Mode=OneWay}"
                 Visibility="{Binding IsUpsertRunning,
                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StatusBar>



        <DataGrid ItemsSource="{Binding MergedRowsView}"
                  x:Name="FilterGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="10,10,10,10"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.ScrollUnit="Item"
                         VirtualizingPanel.CacheLength="2"
                    VirtualizingPanel.CacheLengthUnit="Item"
                    EnableColumnVirtualization="True"
                  FrozenColumnCount="0"
                  PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick"
                      SelectionMode="Single"
                        SelectionUnit="FullRow" Grid.ColumnSpan="2"
                  >

            <!-- Bold headers + show underscores literally -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- Using TextBlock so '_' isn't treated as an access key -->
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Resources>
                <!-- Row context menu -->
                <ContextMenu x:Key="RowContextMenu" x:Shared="False">
                    <MenuItem Header="Delete ticker" Click="DeleteTickerMenuItem_Click"/>
                    <MenuItem Header="Add ticker..." Click="AddTickerMenuItem_Click"/>
                    <MenuItem Header="Scale Position" Click="ScalePosition_Click" />
                    <MenuItem Header="View all scaled positions" Click="ViewScaledPositions_Click" />
                </ContextMenu>

                <!-- Grid empty-area context menu -->
                <ContextMenu x:Key="GridContextMenu" x:Shared="False">
                    <MenuItem Header="Add ticker..." Click="AddTickerMenuItem_Click"/>
                </ContextMenu>

                <Style x:Key="PercentDisplayStyle" TargetType="TextBlock">
                    <Setter Property="Text"
                Value="{Binding ScaleFactor, StringFormat={}{0:P1}}"/>
                </Style>
                <Style x:Key="PercentEditStyle" TargetType="TextBox">
                    <Setter Property="Text"
                Value="{Binding ScaleFactor,
                                Converter={StaticResource NullablePercentDoubleConverter},
                                UpdateSourceTrigger=PropertyChanged}"/>
                </Style>
            </DataGrid.Resources>

            <!-- Select the row under cursor on right-click -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                    <!-- Important: assign a *ContextMenu*, not a MenuItem -->
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                </Style>
            </DataGrid.RowStyle>

            <!-- Context menu for blank grid area -->
            <DataGrid.ContextMenu>
                <!-- Important: the root element must be ContextMenu -->
                <StaticResource ResourceKey="GridContextMenu"/>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <!-- Ticker (read-only) -->
                <DataGridTextColumn Header="ticker"
                                    Binding="{Binding Tickername}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="fundgrp"
                                    Binding="{Binding FundGroup}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="fund"
                                    Binding="{Binding FundName}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="scale_f" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="ScaleFactor"
                 Converter="{StaticResource NullablePercentDoubleConverter}"
                 StringFormat="{}{0:P1}"
                 UpdateSourceTrigger="PropertyChanged" 
                                
                                 />
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewScaleFactorHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NewScaleFactorHasChanged}" Value="True">
                                    <!-- highlight when changed -->
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="new_f" Width="50">
                    <DataGridTextColumn.Binding>
                        <Binding Path="NewScaleFactor"
                             Converter="{StaticResource NullablePercentDoubleConverter}"
                            ConverterCulture="{x:Static globalization:CultureInfo.InvariantCulture}"
                             StringFormat="{}{0:P1}"
                             UpdateSourceTrigger="LostFocus"   
                            ValidatesOnExceptions="True"
                            NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <local:RangeValidationRule
                                    Min="0" Max="3" ValidationStep="ConvertedProposedValue" />
                            </Binding.ValidationRules>
                        </Binding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="local:NumericRangeBehavior.Enable" Value="True"/>
                            <Setter Property="local:NumericRangeBehavior.Min" Value="0"/>
                            <Setter Property="local:NumericRangeBehavior.Max" Value="3"/>
                            <!-- optional: right-align numbers -->
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <!-- cont_upd (toggle via double-click) -->
                <DataGridTextColumn Header="c__upd" IsReadOnly="True">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="When enabled, ticker will be part of a group processed every 5 minutes"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.Binding>
                        <Binding Path="ContUpd" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContUpdHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>
                                <!-- Green when ContUpd is True and not changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ContUpd}" Value="True"/>
                                        <Condition Binding="{Binding ContUpdHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- MANUAL  -->
                <DataGridTextColumn Header="manual" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Manual" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>

                    <!-- optional: center text -->
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <!-- same default border as your other columns -->
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="BorderBrush" Value="#FFBFBFBF"/>
                            <Style.Triggers>
                                <!-- MATCH the other columns’ highlight behaviour -->
                                <DataTrigger Binding="{Binding ManualHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- NEW: when Manual == True AND not changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Manual}" Value="True"/>
                                        <Condition Binding="{Binding ManualHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="Orange"/>
                                    <!-- light orange -->
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- STRATEGY NAME (dropdown; shows text when not editing) -->
                <DataGridTemplateColumn Header="strategy" Width="70">
                    <!-- display -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StrategyName}"
                       VerticalAlignment="Center"
                       Padding="2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StrategyNameHasChanged}" Value="True">
                                                <Setter Property="Background" Value="Khaki"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!-- edit -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="False"
                      ItemsSource="{Binding DataContext.StrategyNames,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      SelectedItem="{Binding StrategyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="140">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StrategyNameHasChanged}" Value="True">
                                                <Setter Property="Background" Value="Khaki"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>




                <!-- Rescale: dropdown True/False, bold when changed -->
                <DataGridTextColumn Header="rescale"
                                    IsReadOnly="True"
                 >
                    <DataGridTextColumn.Binding>
                        <Binding Path="Rescale" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <!-- YELLOW: user changed it (wins) -->
                                <DataTrigger Binding="{Binding RescaleHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>
                                <!-- LIGHT BLUE: different from default AND not changed by user -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="Rescale"/>
                                                    <Binding Path="DataContext.DefaultRescale"
                                         RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding RescaleHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>

                </DataGridTextColumn>

                <!-- LongOnly -->
                <DataGridTextColumn Header="LO"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="LongOnly" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <!-- YELLOW: user changed it -->
                                <DataTrigger Binding="{Binding LongOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- LIGHT BLUE: differs from default AND not user-changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="LongOnly"/>
                                                    <Binding Path="DataContext.DefaultLongOnly"
                                             RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding LongOnlyHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- ShortOnly -->
                <DataGridTextColumn Header="SO"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="ShortOnly" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <!-- YELLOW: user changed it -->
                                <DataTrigger Binding="{Binding ShortOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- LIGHT BLUE: differs from default AND not user-changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="ShortOnly"/>
                                                    <Binding Path="DataContext.DefaultLongOnly"
                                             RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding ShortOnlyHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- BuyOnly -->
                <DataGridTextColumn Header="byO"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="BuyOnly" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <!-- YELLOW: user changed it -->
                                <DataTrigger Binding="{Binding BuyOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- LIGHT BLUE: differs from default AND not user-changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="BuyOnly"/>
                                                    <Binding Path="DataContext.DefaultBuyOnly"
                                             RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding BuyOnlyHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- SellOnly -->
                <DataGridTextColumn Header="slO"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="SellOnly" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>

                                <!-- YELLOW: user changed it -->
                                <DataTrigger Binding="{Binding SellOnlyHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- LIGHT BLUE: differs from default AND not user-changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="SellOnly"/>
                                                    <Binding Path="DataContext.DefaultSellOnly"
                                             RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding SellOnlyHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- all_intervals -->
                <DataGridTextColumn Header="filt_intvls"
       
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="AllIntervals" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <!-- YELLOW: user changed it -->
                                <DataTrigger Binding="{Binding AllIntervalsHasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="Yellow"/>
                                </DataTrigger>

                                <!-- LIGHT BLUE: differs from default AND not user-changed -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True">
                                            <Condition.Binding>
                                                <MultiBinding Converter="{StaticResource NotEqualConverter}">
                                                    <Binding Path="AllIntervals"/>
                                                    <Binding Path="DataContext.DefaultAllIntervals"
                                             RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}"/>
                                                </MultiBinding>
                                            </Condition.Binding>
                                        </Condition>
                                        <Condition Binding="{Binding AllIntervalsHasChanged}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource DiffFromDefaultBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- min_intvl (ComboBox dropdown) -->
                <DataGridTemplateColumn Header="m__int" Width="45">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="Minimum interval set for charting"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MinIntvl}" VerticalAlignment="Center" Padding="2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MinIntvlHasChanged}" Value="True">
                                                <Setter Property="Background" Value="Khaki"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="False"
                                      ItemsSource="{Binding DataContext.MinIntvlOptions,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding MinIntvl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      >
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MinIntvlHasChanged}" Value="True">
                                                <Setter Property="Background" Value="Khaki"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- pos_intvl (ComboBox dropdown) — only editable when c_upd is True -->
                <DataGridTemplateColumn Header="p__int" Width="45">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="Minimum interval for position taking (requires c_upd enabled)"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PosIntvl}" VerticalAlignment="Center" Padding="2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
