                            <Setter Property="FontWeight" Value="Normal"/>
                            <!-- keep only 'changed' emphasis; drop FontSize/Italic (they force re-measure) -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding D8HasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- W2 -->
                <DataGridTextColumn Header="W2"
                    IsReadOnly="True"
                                        >
                    <DataGridTextColumn.Binding>
                        <Binding Path="W2" Converter="{StaticResource BoolToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{Binding W2Brush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <!-- keep only 'changed' emphasis; drop FontSize/Italic (they force re-measure) -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding W2HasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="trades"
                                    Binding="{Binding NumTrades}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="pos_intvls"
                                    Binding="{Binding NumPositionIntervals}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="deploy" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="PositionDeployment"
                     StringFormat="{}{0:P1}"
                     TargetNullValue=""/>
                    </DataGridTextColumn.Binding>
                    <!-- (optional) right-align the text -->
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <!-- Ticker (read-only) -->
                <DataGridTextColumn Header="filt_trades"
                                    Binding="{Binding NumFilteredTrades}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="num_filt_intvls"
                                    Binding="{Binding NumFiltIntervals}"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="filt_deploy" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="FilteredDeployment"
                     StringFormat="{}{0:P1}"
                     TargetNullValue=""/>
                            </DataGridTextColumn.Binding>
                            <!-- (optional) right-align the text -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <!-- new_trades -->
                <DataGridTextColumn Header="new_trades" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="NewTrades" TargetNullValue=""/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="{Binding NewTradesBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- new_intvls -->
                <DataGridTextColumn Header="new_intvls" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="RescaledIntervals" TargetNullValue="" StringFormat="N0"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="Background"   Value="{Binding RescaledIntervalsBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- new_deploy -->
                <DataGridTextColumn Header="new_deploy" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="NewDeployment" StringFormat="{}{0:P1}" TargetNullValue="0" FallbackValue="0"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight"    Value="SemiBold"/>
                            <Setter Property="Background"    Value="{Binding NewDeploymentBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
