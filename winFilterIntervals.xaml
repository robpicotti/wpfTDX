                                    <Setter Property="Background" Value="IndianRed"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseH1}" Value="False"/>
