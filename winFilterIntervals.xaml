                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

                <!-- base_y1: dropdown True/False, bold when changed -->
                <DataGridComboBoxColumn Header="base__y1"
                    SelectedItemBinding="{Binding BaseY1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:Boolean}">
                            <sys:Boolean>True</sys:Boolean>
                            <sys:Boolean>False</sys:Boolean>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>

                    <!-- Bold the whole cell when changed -->
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BaseY1HasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PositionBaseY1}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </DataTrigger>
                                <!-- Light green when BaseY1 == true AND PositionBaseY1 == 1 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="-1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MistyRose"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="-1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="IndianRed"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="1"/>
                                        <!-- if it's a double, "1" parses to 1.0 -->
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                    <!-- or a softer green: #DFF6DD -->
                                </MultiDataTrigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

