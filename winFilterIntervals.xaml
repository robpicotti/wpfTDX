                <!-- base_y1 -->
                <DataGridComboBoxColumn Header="base_y1"
                    ItemsSource="{StaticResource BoolOptions}"
                    SelectedItemBinding="{Binding BaseY1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BaseY1HasChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontStyle"  Value="Italic"/>
                                    <Setter Property="FontSize"   Value="14"/>
                                </DataTrigger>

                                <!-- Grey when PositionBaseY1 is null -->
                                <DataTrigger Binding="{Binding PositionBaseY1}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FFE0E0E0"/>
                                </DataTrigger>

                                <!-- BaseY1 true + pos 1 = green -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="PaleGreen"/>
                                </MultiDataTrigger>

                                <!-- BaseY1 true + pos -1 = light red -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="True"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="-1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MistyRose"/>
                                </MultiDataTrigger>

                                <!-- BaseY1 false + pos -1 = strong red -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="-1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="IndianRed"/>
                                </MultiDataTrigger>

                                <!-- BaseY1 false + pos 1 = green (different shade) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BaseY1}" Value="False"/>
                                        <Condition Binding="{Binding PositionBaseY1}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="MediumSeaGreen"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.CellStyle>
                </DataGridComboBoxColumn>

