<UserControl x:Class="wpfTDX.ucLimits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="800">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fund picker + Busy indicator (FIXED POSITIONING) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Fund picker -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="fundname" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cboFundName"
                          SelectionChanged="cboFundName_SelectionChanged"
                          Width="200"/>
            </StackPanel>

            <!-- Busy indicator (moved DOWN so it lines up with ComboBox, not the label) -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,24,0,0"
                        VerticalAlignment="Top">
                <ProgressBar x:Name="pbBusy"
                             Width="180"
                             Height="14"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="txtBusy"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Loading…"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Border Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="1"
                Background="Orange"
                Padding="8">

            <TabControl>

                <!-- FUND LIMITS -->
                <TabItem Header="Fund Limits" FontWeight="Bold">
                    <Grid>
                        <DataGrid x:Name="dgFundLimits"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="5"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FundName" Binding="{Binding fundname}"/>
                                <DataGridTextColumn Header="Metric" Binding="{Binding metric}"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding custom}"/>

                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>

                                <DataGridTextColumn Header="Live" Binding="{Binding live}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>

                                <DataGridTemplateColumn Header="Save">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Save"
                                                    Padding="4"
                                                    Tag="Fund"
                                                    Click="RowSave_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                            <Setter Property="Background" Value="Yellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                            <Setter Property="Background" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="G">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- NOTIONAL LIMITS -->
                <TabItem Header="Notional Limits" FontWeight="Bold">
                    <Grid>
                        <DataGrid x:Name="dgTickerLimits"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="5"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>

                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_1"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>

                                <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>

                                <DataGridTemplateColumn Header="Save">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Save"
                                                    Padding="4"
                                                    Tag="Notional"
                                                    Click="RowSave_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                            <Setter Property="Background" Value="Yellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                            <Setter Property="Background" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="G">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- LIQUIDITY LIMITS -->
                <TabItem Header="Liquidity Limits" FontWeight="Bold">
                    <Grid>
                        <DataGrid x:Name="dgLiquidityLimits"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="5"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>

                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_1"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>

                                <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>

                                <DataGridTemplateColumn Header="Save">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Save"
                                                    Padding="4"
                                                    Tag="Liquidity"
                                                    Click="RowSave_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                            <Setter Property="Background" Value="Yellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                            <Setter Property="Background" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="G">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- WEIGHT LIMITS -->
                <TabItem Header="Weight Limits" FontWeight="Bold">
                    <Grid>
                        <DataGrid x:Name="dgWeightLimits"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Margin="5"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>

                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_4"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>

                                <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>

                                <DataGridTemplateColumn Header="Save">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Save"
                                                    Padding="4"
                                                    Tag="Weight"
                                                    Click="RowSave_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                            <Setter Property="Background" Value="Yellow"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                            <Setter Property="Background" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Color}" Value="G">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>

</UserControl>
