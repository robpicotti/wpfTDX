<UserControl x:Class="wpfTDX.ucLimits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignWidth="1500" Height="500">
    <StackPanel Margin="2">
        
        <StackPanel  Margin="5">
            <Button x:Name="cmdClose" 
                            Click="cmdClose_Click" 
                            Content="X" 
                            FontWeight="Bold" 
                            Width="40"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top"
                            Background="LightGray"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="fundname" FontWeight="Bold" Margin="5"/>
            <ComboBox x:Name="cboFundName" 
                              SelectionChanged="cboFundName_SelectionChanged"
                              Margin="5" HorizontalAlignment="Left" 
                              Width="150"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <!--</Border>-->
            <ScrollViewer  VerticalScrollBarVisibility="Auto">
                <Border BorderBrush="Black" BorderThickness="1"  Background="Orange"  Padding="5" Margin="8" >
                <TabControl >
                        <TabItem Header="Fund Limits" FontWeight="Bold">
                            <StackPanel>
                                <!--<Button x:Name="btnUpdateCustom" 
                                    Content="update custom value" Padding="5" HorizontalAlignment="Left" Margin="5" 
                                    Visibility="Hidden"
                                    FontWeight="Bold"/>-->
                                <DataGrid 
                                    x:Name="dgFundLimits" 
                                    AutoGenerateColumns="False" 
                                    Height="400"
                                      ScrollViewer.CanContentScroll="True" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    Margin="5" CellEditEnding="dgFundLimits_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="FundName" Binding="{Binding fundname}"/>
                                        <DataGridTextColumn Header="Metric" Binding="{Binding metric}"/>
                                        <DataGridTextColumn Header="Default" Binding="{Binding default}"/>
                                        <DataGridTextColumn Header="Custom" Binding="{Binding custom}"/>
                                        <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding action}">
                                            <DataGridComboBoxColumn.ElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged"/>
                                                    <Setter Property="ItemsSource">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{local:ActionItemsConverter}">
                                                                <Binding Path="action" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridComboBoxColumn.ElementStyle>
                                            <DataGridComboBoxColumn.EditingElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="ItemsSource">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{local:ActionItemsConverter}">
                                                                <Binding Path="action" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridComboBoxColumn.EditingElementStyle>
                                        </DataGridComboBoxColumn>
                                        <DataGridTextColumn Header="Live" Binding="{Binding live}"/>
                                        <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                                    <Setter Property="Background" Value="Yellow"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </StackPanel>
                        <!--</ScrollViewer>-->
                    </TabItem>
                    <TabItem Header="Notional Limits" FontWeight="Bold">
                            <!--<ScrollViewer VerticalScrollBarVisibility="Auto">-->
                                <StackPanel>
                            <!--<Button x:Name="btnUpdateTickerLimits" Click="btnUpdateTickerLimits_Click"
                                    Content="update custom value" Padding="5" HorizontalAlignment="Left" Margin="5" 
                                    Visibility="Hidden"
                                    FontWeight="Bold" />-->
                            <!--<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">-->
                                <DataGrid x:Name="dgTickerLimits"  AutoGenerateColumns="False" Margin="5" 
                                          Height="400"
                                      ScrollViewer.CanContentScroll="True" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      CellEditEnding="dgTickerLimits_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                        <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                        <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                        <!--Notional data-->
                                        <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                        <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>
                                        <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                            <DataGridComboBoxColumn.ElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_1"/>
                                                    <Setter Property="ItemsSource">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{local:ActionItemsConverter}">
                                                                <Binding Path="Action" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridComboBoxColumn.ElementStyle>
                                            <DataGridComboBoxColumn.EditingElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="ItemsSource">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{local:ActionItemsConverter}">
                                                                <Binding Path="Action" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridComboBoxColumn.EditingElementStyle>
                                        </DataGridComboBoxColumn>
                                        <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                        <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                        <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                                    <Setter Property="Background" Value="Yellow"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            <!--</ScrollViewer>-->
                        </StackPanel>
                            <!--</ScrollViewer>-->
                        </TabItem>
                    <TabItem Header="Liquidity Limits" FontWeight="Bold">
                        <DataGrid x:Name="dgLiquidityLimits"  AutoGenerateColumns="False" Margin="5" 
                                      Height="400"
                                      ScrollViewer.CanContentScroll="True" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      CellEditEnding="dgLiquidityLimits_CellEditEnding">
                            <DataGrid.Columns>
                                    <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                    <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                <!--Notional data-->
                                <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>
                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_1"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                                <Setter Property="Background" Value="Yellow"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                                <Setter Property="Background" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                    </TabItem>
                    <TabItem Header="Weight Limits" FontWeight="Bold">
                        <DataGrid x:Name="dgWeightLimits"  AutoGenerateColumns="False" Margin="5" 
                                        Height="200"
                                      ScrollViewer.CanContentScroll="True" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      CellEditEnding="dgWeightLimits_CellEditEnding">
                            <DataGrid.Columns>
                                    <DataGridTextColumn Header="fundname" Binding="{Binding fundname}"/>
                                    <DataGridTextColumn Header="benchmarkname" Binding="{Binding benchmarkname}"/>
                                <DataGridTextColumn Header="tickername" Binding="{Binding tickername}"/>
                                <!--Notional data-->
                                <DataGridTextColumn Header="Default" Binding="{Binding Default}"/>
                                <DataGridTextColumn Header="Custom" Binding="{Binding Custom}"/>
                                <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding Action}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="ComboBox_SelectionChanged_4"/>
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{local:ActionItemsConverter}">
                                                        <Binding Path="Action" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Live" Binding="{Binding Live}"/>
                                <DataGridTextColumn Header="Frozen" Binding="{Binding Frozen}"/>
                                <DataGridTextColumn Header="Flagged" Binding="{Binding Flagged}" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Visibility="Hidden"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Color}" Value="Y">
                                                <Setter Property="Background" Value="Yellow"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Color}" Value="R">
                                                <Setter Property="Background" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </ScrollViewer>
    </Grid>
    </StackPanel>
</UserControl>
