<Window x:Class="wpfTDX.winAddTicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Ticker" Height="500" Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter + Add button on the same row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="240" TextChanged="FilterBox_TextChanged" Margin="0,0,8,0"/>
            <Button x:Name="BtnAdd" Content="Add" Width="90" Click="BtnAdd_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridTickers"
            Grid.Row="1"
            AutoGenerateColumns="False"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            IsReadOnly="False"
            CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticker"       Binding="{Binding TickerName}"    IsReadOnly="True"/>
                <DataGridTextColumn Header="Description"  Binding="{Binding Description}"   IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Fund Group">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FundGroups}"
                                    SelectedItem="{Binding FundGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MinWidth="140"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


            </DataGrid.Columns>
        </DataGrid>
    </Grid>



</Window>
