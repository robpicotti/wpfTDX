<Window x:Class="wpfTDX.winSystemTrades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Trades" Width="1480" Height="880" MinWidth="980" MinHeight="640"
        Background="#F3F5F8" Foreground="#17253D" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#607089"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="245" MinHeight="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Background="#E5EAF1" CornerRadius="4" Padding="10,6" VerticalAlignment="Top">
                <TextBlock Text="{Binding CaptureStatus}" TextWrapping="Wrap" MaxWidth="360"/>
            </Border>
            <StackPanel>
                <TextBlock Text="System Trades" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Recorded model trades and their review decisions" Foreground="#607089" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
            <WrapPanel>
                <StackPanel Width="170" Margin="0,0,14,0">
                    <TextBlock Text="Fund" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FundFilter, UpdateSourceTrigger=PropertyChanged}" KeyDown="FilterKeyDown" ToolTip="Exact fund name. Leave blank for all funds."/>
                </StackPanel>
                <StackPanel Width="155" Margin="0,0,14,0">
                    <TextBlock Text="Ticker" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TickerFilter, UpdateSourceTrigger=PropertyChanged}" KeyDown="FilterKeyDown" ToolTip="Exact ticker name. Leave blank for all tickers."/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,14,0">
                    <TextBlock Text="Review" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ReviewFilters}" SelectedItem="{Binding ReviewFilter, UpdateSourceTrigger=PropertyChanged}" Tag="Review" SelectionChanged="FilterSelectionChanged"/>
                </StackPanel>
                <StackPanel Width="130" Margin="0,0,14,0">
                    <TextBlock Text="Trade status" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding TradeStatusFilters}" SelectedItem="{Binding TradeStatusFilter, UpdateSourceTrigger=PropertyChanged}" Tag="TradeStatus" SelectionChanged="FilterSelectionChanged"/>
                </StackPanel>
                <TextBlock Text="Auto-refresh: 15 seconds" Foreground="#607089" VerticalAlignment="Bottom" Margin="0,0,0,8"
                           ToolTip="Review and trade status filters apply immediately. Press Enter in Fund or Ticker to apply immediately. Refresh pauses while reviewing a trade."/>
            </WrapPanel>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                <ProgressBar x:Name="TradeLoadProgress" Height="7" IsIndeterminate="True" Foreground="#3168C6"/>
                <TextBlock Text="{Binding Status}" Foreground="#607089" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock DockPanel.Dock="Right" Text="Model entry / exit values | All times UTC" Foreground="#607089"/>
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
        </DockPanel>
        <Grid Grid.Row="3">
            <DataGrid x:Name="TradesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedTrade}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" FrozenColumnCount="1" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF3" BorderBrush="#DCE2EA"
                      Background="White" AlternatingRowBackground="#F7F9FC" RowHeight="30"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="TradeRowDoubleClick"/>
                        <Setter Property="ToolTip" Value="Double-click to review this trade"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E9EEF5"/>
                        <Setter Property="Foreground" Value="#17253D"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticker" Binding="{Binding Tickername}" Width="105"/>
                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="85"/>
                    <DataGridTextColumn Header="Interval" Binding="{Binding Intervalname}" Width="90"/>
                    <DataGridTextColumn Header="Group" Binding="{Binding Groupname}" Width="100"/>
                    <DataGridTextColumn Header="Entry UTC" Binding="{Binding EntryUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Entry price" Binding="{Binding EntryPrice, StringFormat=N4}" Width="105"/>
                    <DataGridTextColumn Header="Entry VaR" Binding="{Binding EntryVar, StringFormat=G6}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding TradeStatus}" Width="80"/>
                    <DataGridTextColumn Header="Review" Binding="{Binding ReviewLabel}" Width="105"/>
                    <DataGridTextColumn Header="Strategy" Binding="{Binding Strategyname}" Width="210"/>
                    <DataGridTextColumn Header="Fund" Binding="{Binding Fundname}" Width="120"/>
                    <DataGridTextColumn Header="System exit UTC" Binding="{Binding ExitUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="System exit price" Binding="{Binding ExitPrice, StringFormat=N4}" Width="105"/>
                    <DataGridTextColumn Header="Exit decision" Binding="{Binding ExitDecisionLabel}" Width="115"/>
                    <DataGridTextColumn Header="Discretionary exit UTC" Binding="{Binding DiscretionaryExitUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="175"/>
                    <DataGridTextColumn Header="Discretionary exit price" Binding="{Binding DiscretionaryExitPrice, StringFormat=G10}" Width="145"/>
                    <DataGridTextColumn Header="Discretionary exit reason" Binding="{Binding DiscretionaryExitReason}" Width="260"/>
                    <DataGridTextColumn Header="Reviewed by" Binding="{Binding DecisionBy}" Width="110"/>
                    <DataGridTextColumn Header="Reviewed UTC" Binding="{Binding DecisionUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Rejection reason" Binding="{Binding RejectionReason}" Width="250"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Background="#F7F9FC" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="No trades to display. Check the filters and load status below." TextWrapping="Wrap" Foreground="#607089"/>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
        <Border Grid.Row="5" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <TextBlock Text="Select a trade to inspect its entry evidence and recorded review." Foreground="#607089" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                    <Grid DataContext="{Binding SelectedTrade}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding Strategyname}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding CriteriaVersion, StringFormat=Criteria: {0}}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding SourceUpdatedUtc, StringFormat=Source updated: {0:yyyy-MM-dd HH:mm:ss} UTC}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding TradeId, StringFormat=Source trade: {0}}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding SystemTradeId}" Foreground="#607089" FontSize="10" Style="{StaticResource DetailText}" ToolTip="System trade ID"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Text="Recorded review" FontWeight="SemiBold" Margin="0,0,0,9"/>
                            <TextBlock Text="{Binding ReviewLabel}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding DecisionBy, StringFormat=Reviewer: {0}, TargetNullValue=Reviewer: Unavailable}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding ReviewTimeLabel}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding RejectionReason}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding DecisionVersion, StringFormat=Review version: {0}}" Foreground="#607089"/>
                            <TextBlock Text="{Binding ExitDecisionLabel, StringFormat=Exit decision: {0}}" Style="{StaticResource DetailText}" Margin="0,8,0,6"/>
                            <TextBlock Text="{Binding DiscretionaryExitUtc, StringFormat=Discretionary exit: {0:yyyy-MM-dd HH:mm:ss} UTC}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding DiscretionaryExitPrice, StringFormat=Discretionary price: {0:G10}}" Style="{StaticResource DetailText}"/>
                            <TextBlock Text="{Binding DiscretionaryExitReason}" Style="{StaticResource DetailText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qualification at signal entry" FontWeight="SemiBold" Margin="0,0,0,9"/>
                            <TextBlock Text="{Binding QualificationText}" Style="{StaticResource DetailText}"/>
                            <Expander Header="Recorded evidence JSON" Margin="0,6,0,0">
                                <TextBox Text="{Binding CriteriaSnapshot, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <Button Content="Review / edit selected trade..." Click="ReviewClick" IsEnabled="{Binding CanReview}"
                    HorizontalAlignment="Left" Padding="16,7" Margin="0,0,0,9"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Text="Decisions record a review; they do not submit orders or change deployment."
                       Foreground="#607089" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
