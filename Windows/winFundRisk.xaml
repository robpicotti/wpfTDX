<Window x:Class="wpfTDX.winFundRisk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fund Risk &amp; Performance" Width="1440" Height="960"
        MinWidth="1050" MinHeight="700" Background="#F3F5F9" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Language="en-GB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="5,0,15,0"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5,0,12,0"/>
            <Setter Property="Width" Value="125"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Fund Risk &amp; Performance" FontSize="25" FontWeight="SemiBold" Foreground="#17253D"/>
            <TextBlock Text="Risk, limits and performance from recorded fund snapshots" Foreground="#607089" Margin="0,4,0,18"/>
            <WrapPanel x:Name="Filters" VerticalAlignment="Center">
                <TextBlock Text="Fund" VerticalAlignment="Center"/>
                <ComboBox x:Name="FundPicker" Width="190" SelectionChanged="FilterChanged"/>
                <ComboBox x:Name="ModePicker" Width="100" SelectedIndex="0" SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="Daily"/><ComboBoxItem Content="Intraday"/>
                </ComboBox>
                <TextBlock x:Name="FromLabel" Text="From" VerticalAlignment="Center"/>
                <DatePicker x:Name="FromPicker" SelectedDateChanged="DateChanged"/>
                <TextBlock Text="To / trading date" VerticalAlignment="Center"/>
                <DatePicker x:Name="ToPicker" SelectedDateChanged="DateChanged"/>
                <Button Content="Refresh" Click="RefreshClick"/>
                <CheckBox x:Name="AutoRefresh" Content="Auto-refresh (60s)" VerticalAlignment="Center" Margin="10,0"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Text="Loading funds..." Foreground="#607089" Margin="0,12,0,12" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <UniformGrid x:Name="Cards" Columns="5" Margin="-5,0,-5,12"/>
                <Border Background="White" Padding="14,10" CornerRadius="6" Margin="0,0,0,14">
                    <TextBlock x:Name="PerformanceStrip" Foreground="#394B66" TextWrapping="Wrap"/>
                </Border>
                <UniformGrid x:Name="Charts" Columns="2"/>
                <Border Background="White" CornerRadius="6" Margin="5,5,5,14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Gross risk by category" FontSize="16" FontWeight="SemiBold" Foreground="#17253D"/>
                        <TextBlock Text="Selected period's latest snapshot. Gross allocation is distinct from portfolio VaR." Foreground="#607089" Margin="0,4,0,8"/>
                        <ContentControl x:Name="CategoryChart" Height="285"/>
                        <TextBlock x:Name="CategoryNote" Foreground="#607089"/>
                    </StackPanel>
                </Border>
                <Expander Header="Risk details and recorded observations" Background="White" Padding="14" Margin="5">
                    <StackPanel>
                        <TextBlock x:Name="Details" Margin="0,10" TextWrapping="Wrap" Foreground="#394B66"/>
                        <Button Content="Export observations to CSV" HorizontalAlignment="Left" Click="ExportClick" Margin="0,0,0,10"/>
                        <DataGrid x:Name="Observations" Height="275" IsReadOnly="True" AutoGenerateColumns="True"
                                  CanUserAddRows="False" FrozenColumnCount="1"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
