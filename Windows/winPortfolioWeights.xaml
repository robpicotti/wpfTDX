<Window x:Class="wpfTDX.winPortfolioWeights"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
        mc:Ignorable="d"
        xml:lang="en-GB"
        Title="Manage Portfolio Weights"
        Height="640" Width="980">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="SearchBoxStyle">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Control" x:Key="ValidationStyle">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="GridHeaderStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top filter row -->
        <Grid Grid.Row="0" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ticker filter -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter tickers:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="260"
                         Style="{StaticResource SearchBoxStyle}"
                         Text="{Binding TickerFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type to filter tickers on the left"/>
            </StackPanel>

            <!-- Portfolio selector -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Portfolio:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="240"
                          ItemsSource="{Binding PortfolioData}"
                          DisplayMemberPath="BenchmarkName"
                          SelectedValuePath="BenchmarkName"
                          SelectedValue="{Binding SelectedPortfolioName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedIndex="-1"
                          IsSynchronizedWithCurrentItem="False"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Tickers list -->
            <GroupBox Grid.Column="0" Header="Tickers" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="6,4,6,6" Opacity="0.7"
                               Text="{Binding FilteredTickers.ItemCount, StringFormat='Items: {0}'}"/>
                    <ListBox x:Name="TickersList"
                             ItemsSource="{Binding FilteredTickers}"
                             DisplayMemberPath="Tickername"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </GroupBox>

            <!-- Middle: Add/Remove buttons -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                <Button Content="Add →"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        Command="{Binding AddSelectedTickersCommand}"
                        CommandParameter="{Binding ElementName=TickersList, Path=SelectedItems}"/>
                <Button Content="← Remove"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        Command="{Binding RemoveSelectedWeightsCommand}"
                        CommandParameter="{Binding ElementName=WeightsGrid, Path=SelectedItems}"/>
                <Separator Margin="0,8"/>
                <Button Content="Save"
                        Padding="10,6"
                        Command="{Binding SaveChangesCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
            </StackPanel>

            <!-- Right: Portfolio weights -->
            <GroupBox Grid.Column="2" Header="Portfolio Weights">
                <DataGrid x:Name="WeightsGrid"
                          ItemsSource="{Binding PortfolioWeights}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          Margin="0"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                    <DataGrid.Columns>

                        <!-- Status dot column -->
                        <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Green dot — newly added this session -->
                                        <Ellipse Width="14" Height="14" Margin="2"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="LimeGreen">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Red dot — flagged for removal -->
                                        <Ellipse Width="14" Height="14" Margin="2"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="Crimson">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMarkedForRemoval}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TickerName (readonly) -->
                        <DataGridTextColumn Header="Tickername"
                                            IsReadOnly="True"
                                            Binding="{Binding TickerName}"
                                            Width="*"/>

                        <!-- Weight (editable) -->
                        <DataGridTextColumn Header="Weight" Width="1.2*">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Weight"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         ValidatesOnDataErrors="True"
                                         NotifyOnValidationError="True"
                                         ConverterCulture="{x:Static gl:CultureInfo.InvariantCulture}"
                                         StringFormat="0.########"/>
                            </DataGridTextColumn.Binding>

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>

                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ValidationStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="150"
                                 Height="14"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
