<UserControl x:Class="wpfTDX.ucMtm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1800">
    <UserControl.Resources>
        <!-- Standard BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Custom InverseBooleanToVisibilityConverter -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>


    <StackPanel Margin="2">
        <!-- Header Section with ComboBox, DatePickers, and Buttons -->
        <Border BorderBrush="Black" Background="PaleGreen" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- fundname -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="fundname" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboFundname" 
                              ItemsSource="{Binding Funds}" DisplayMemberPath="FundName"
                              SelectedItem="{Binding SelectedFund, Mode=TwoWay}" />
                </StackPanel>

                <!-- from date -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="from date" FontWeight="Bold" Margin="5 1"/>
                    <DatePicker x:Name="dtFrom"
                                SelectedDate="{Binding Date_tminus1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- to date -->
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="to date" FontWeight="Bold" Margin="5 1"/>
                    <DatePicker x:Name="dtTo"
                                SelectedDate="{Binding Date_t, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- base currency -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="base currency" FontWeight="Bold" Margin="5 8"/>
                    <TextBox x:Name="txtBaseCurrency" FontWeight="Bold" Margin="5 -8" IsReadOnly="True" 
                             Text="{Binding SelectedFund.BaseCurrency, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Run Button with RelayCommand -->
                <StackPanel Grid.Column="4" Margin="5 23">
                    <Button x:Name="cmdRun" 
                            Command="{Binding RunMtmCommand}" 
                            Content="{Binding RunStatus, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="12"
                            Background="LightGray" 
                            FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="5 23" Grid.ColumnSpan="2">
                    <TextBlock 
                        Text="{Binding DisplayRunStatus, UpdateSourceTrigger=PropertyChanged}" 
                        FontWeight="Bold"
                        Foreground="Red"       
                               />
                </StackPanel>

                <!-- Close Button -->
                <!--<StackPanel Grid.Column="8" Margin="5">
                    <Button x:Name="cmdClose" Click="cmdClose_Click" Content="x" FontWeight="Bold" />
                </StackPanel>-->
            </Grid>
        </Border>

        <!-- Totals Section (Always Visible) -->
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="total pnl:" FontWeight="Bold" Margin="5"/>
                    <TextBox IsReadOnly="True" x:Name="txtTotalPnlFutures" Margin="5" Text="{Binding TotalPnl,Mode=OneWay,StringFormat={}{0:N2}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" >
                    <TextBlock Text="position pnl:" FontWeight="Bold" Margin="5" />
                    <TextBox  IsReadOnly="True" x:Name="txtPosnPnlFutures" Margin="5" 
                              Text="{Binding TotalBuyAndHold,Mode=OneWay,StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="new deals pnl:" FontWeight="Bold" Margin="5"/>
                    <TextBox IsReadOnly="True" x:Name="txtNewDealsPnlFutures" 
                             Text="{Binding TotalNewDeals,Mode=OneWay,StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="commission:" FontWeight="Bold" Margin="5"/>
                    <TextBox IsReadOnly="True" x:Name="txtCommissionFutures" Margin="5"
                             Text="{Binding TotalCommissions,Mode=OneWay,StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Single Day View -->
        <StackPanel>
            <StackPanel x:Name="SingleDayView" Visibility="{Binding ShowMultiDay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
   
                <TextBlock Text="Position PnL:" FontWeight="Bold" Margin="5" />
                <DataGrid x:Name="dgFutures" 
                          ItemsSource="{Binding BuyAndHoldData, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          Height="200"     
                          Margin="5"
                          ScrollViewer.CanContentScroll="True" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          IsReadOnly="True"
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="IncludeHeader"  
                          ColumnWidth="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Black" />
                            <!-- Set background to black -->
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="TadID" Binding="{Binding TadId}" MinWidth="80" />
                        <DataGridTextColumn Header="Tickername" Binding="{Binding Tickername}" MinWidth="80" />
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" MinWidth="80" />
                        <DataGridTextColumn Header="Exch Curr" Binding="{Binding ExchangeCurrency}" MinWidth="80" />
                        <DataGridTextColumn Header="Posn Tminus" Binding="{Binding ExecutedQuantity,StringFormat={}{0:N0}}" MinWidth="80" />
                        <DataGridTextColumn Header="Closing Price T" Binding="{Binding ClosingPriceT,StringFormat={}{0:N2}}" MinWidth="100" />
                        <DataGridTextColumn Header="Closing Price Tminus" Binding="{Binding ClosingPriceTMinus1,StringFormat={}{0:N2}}" MinWidth="120" />
                        <DataGridTextColumn Header="Cash T" Binding="{Binding CashT,StringFormat={}{0:N0}}" MinWidth="50"/>
                        <DataGridTextColumn Header="Cash Tminus" Binding="{Binding CashTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="MtM T" Binding="{Binding MtmT,StringFormat={}{0:N0}}" MinWidth="50"/>
                        <DataGridTextColumn Header="MtM Tminus" Binding="{Binding MtmTMinus1,StringFormat={}{0:N0}}" MinWidth="80"/>
                        <DataGridTextColumn Header="Adj MtM Tminus" Binding="{Binding AdjustedMtmTMinus1,StringFormat={}{0:N0}}" MinWidth="100" />
                        <DataGridTextColumn Header="Adj Cash Tminus" Binding="{Binding AdjustedCashTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="Commission (Base Curr)" Binding="{Binding CommissionBaseCurrency, StringFormat={}{0:N0}}" MinWidth="130"/>
                        <DataGridTextColumn Header="Pnl (Base Curr)" Binding="{Binding PnlBaseCurrency, StringFormat={}{0:N0}}" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="New Deals PnL:" FontWeight="Bold" Margin="5" />
                <DataGrid x:Name="dgFuturesNewDeals" 
                          ItemsSource="{Binding NewDealsData, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          Height="200"     
                          Margin="5"
                          ScrollViewer.CanContentScroll="True" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          IsReadOnly="True"
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="IncludeHeader"  
                          ColumnWidth="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Black" />
                            <!-- Set background to black -->
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TadID" Binding="{Binding TadId}" MinWidth="80"/>
                        <DataGridTextColumn Header="Tickername" Binding="{Binding Tickername}" MinWidth="80"/>
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" MinWidth="80"/>
                        <DataGridTextColumn Header="Exch Curr" Binding="{Binding ExchangeCurrency}" MinWidth="80"/>
                        <DataGridTextColumn Header="Exec time" Binding="{Binding ExecutionTime}" MinWidth="80"/>
                        <DataGridTextColumn Header="Exec Qty" Binding="{Binding ExecutedQuantity,StringFormat={}{0:N0}}" MinWidth="80"/>
                        <DataGridTextColumn Header="Tx Price" Binding="{Binding TransactionPrice,StringFormat={}{0:N2}}" MinWidth="80"/>
                        <DataGridTextColumn Header="Closing Price" Binding="{Binding ClosingPriceT,StringFormat={}{0:N2}}" MinWidth="100"/>
                        <DataGridTextColumn Header="Cash T" Binding="{Binding CashT,StringFormat={}{0:N0}}" MinWidth="80"/>
                        <DataGridTextColumn Header="Cash Tminus" Binding="{Binding CashTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="MtM T" Binding="{Binding MtmT,StringFormat={}{0:N0}}" MinWidth="80"/>
                        <DataGridTextColumn Header="MtM Tminus" Binding="{Binding MtmTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="Adj MtM Tminus" Binding="{Binding AdjustedMtmTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="Adj Cash Tminus" Binding="{Binding AdjustedCashTMinus1,StringFormat={}{0:N0}}" MinWidth="100"/>
                        <DataGridTextColumn Header="FX Currency" Binding="{Binding SpotCurrency}" MinWidth="100"/>
                        <DataGridTextColumn Header="FX Spot Rate" Binding="{Binding FXSpotRate,StringFormat={}{0:N5}}" MinWidth="100"/>
                        <DataGridTextColumn Header="Commission (Base Curr)" Binding="{Binding CommissionBaseCurrency, StringFormat={}{0:N2}}" MinWidth="130"/>
                        <DataGridTextColumn Header="Pnl (Base Curr)" Binding="{Binding PnlBaseCurrency, StringFormat={}{0:N2}}" MinWidth="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Multi Day View -->
            <StackPanel x:Name="MultiDayView" Visibility="{Binding ShowMultiDay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Multi Day Position PnL:" FontWeight="Bold" Margin="5" />
                
                <DataGrid x:Name="dgMultiDay" 
                          ItemsSource="{Binding BuyAndHoldData, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          Height="400"     
                          Margin="5"
                          ScrollViewer.CanContentScroll="True" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          IsReadOnly="True"
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow"
                          ClipboardCopyMode="IncludeHeader"  
                          ColumnWidth="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Black" />
                            <!-- Set background to black -->
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TadID" Binding="{Binding TadId}" MinWidth="80"/>
                        <DataGridTextColumn Header="Tickername" Binding="{Binding Tickername}" MinWidth="80"/>
                        <DataGridTextColumn Header="Posn" Binding="{Binding ExecutedQuantity,StringFormat={}{0:N0}}" MinWidth="80" />
                        <DataGridTextColumn Header="Commission (Base Curr)" Binding="{Binding CommissionBaseCurrency, StringFormat={}{0:N0}}" MinWidth="130"/>
                        <DataGridTextColumn Header="Pnl (Base Curr)" Binding="{Binding PnlBaseCurrency, StringFormat={}{0:N0}}" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
