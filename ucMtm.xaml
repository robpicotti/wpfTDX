<UserControl x:Class="wpfTDX.ucMtm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1800">
    <StackPanel Margin="2" >
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- fundname-->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="fundname" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboFundname" ItemsSource="{Binding}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="from date" FontWeight="Bold" Margin="5 1"/>
                    <DatePicker x:Name="dtFrom"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="to date" FontWeight="Bold" Margin="5 1"/>
                    <DatePicker x:Name="dtTo"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="5 25">
                    <Button x:Name="cmdRun" Click="cmdRun_Click"  Content="Run" Background="LightGray" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="5">
                    <Button x:Name="cmdClose" Click="cmdClose_Click" Content="x" Margin="1 -5 -5 0" Background="Gray" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <TabControl>
                <!-- total pnl data-->
                <TabItem Header="Total">
                    <StackPanel>
                        <DataGrid x:Name="dgTotal" AutoGenerateColumns="True"></DataGrid>
                    </StackPanel>
                </TabItem>
                <!-- equities data-->
                <TabItem Header="Equities">
                    <StackPanel>
                        <DataGrid x:Name="dgEquities" AutoGenerateColumns="True">
                        </DataGrid>
                        <DataGrid x:Name="dgEquitiesNewDeals" AutoGenerateColumns="True" Margin="1 5 1 5"></DataGrid>
                    </StackPanel>
                </TabItem>
                <!-- fututes data-->
                <TabItem Header="Futures">
                    <StackPanel>
                        <DataGrid x:Name="dgFutures" AutoGenerateColumns="True"></DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </StackPanel>
</UserControl>
