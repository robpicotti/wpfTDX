<UserControl x:Class="wpfTDX.ucDeposits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="2">
        <TextBlock Text="Account deposit" FontSize="20" FontWeight="Bold" Margin="5" />
        <Border BorderBrush="Black" BorderThickness="1"  Background="Khaki" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="fundname:" FontWeight="Bold" Margin="5 1" />
                    <ComboBox x:Name="cboFundname" IsReadOnly="True" SelectionChanged="cboFundname_SelectionChanged" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="subaccountname:" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboSubaccount" SelectionChanged="cboSubaccount_SelectionChanged" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="broker code" FontWeight="Bold" Margin="5 1" />
                    <ComboBox x:Name="cboBrokerCode" Margin="5"></ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="execution broker code" Margin="5 1" FontWeight="Bold"/>
                    <ComboBox x:Name="cboExecBrokerCode" Margin="5" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <Button x:Name="cmdClose" Click="cmdClose_Click"  Content="X"  FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="transaction type detail" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboTxtypeDetail" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="transaction date" FontWeight="Bold" Margin="5 1"/>
                    <DatePicker x:Name="dtpTxDate" Margin="5 4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="currency" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboCurrency" SelectionChanged="cboCurrency_SelectionChanged"  Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="tad_id" FontWeight="Bold" Margin="5 1"/>
                    <TextBox x:Name="txtTadId" IsReadOnly="True" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">

                    <TextBlock Text="amount (non-directional)" FontWeight="Bold" Margin="5 1"/>

                    <TextBox x:Name="txtAmount"  Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Button x:Name="cmdAdd" Click="cmdAdd_Click"  Content="Deposit" FontWeight="Bold" Margin="5 22"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
