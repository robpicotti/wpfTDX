<UserControl x:Class="wpfTDX.ucDeposits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="2">
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="fundname:" FontWeight="Bold" Margin="5 1" />

                    <ComboBox x:Name="cboFundname" IsReadOnly="True" Margin="5"/>

                    <TextBlock Text="subaccount name:" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboSubaccountName" Margin="5"/>

                    <TextBlock Text="broker code" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboBrokerCode" Margin="5"/>

                    <TextBlock Text="executing broker code" FontWeight="Bold" Margin="5 1"/>
                    <ComboBox x:Name="cboExecBrokerCode" FontWeight="Bold" Margin="5"/>

                    <Button x:Name="cmdClose" Click="cmdClose_Click" Content="X" Margin="1 -5 -5 0" BorderBrush="White" Background="White" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                <!-- Row 1 -->
                    <TextBlock Text="transaction type detail" FontWeight="Bold" Margin="5" Grid.Row="1"/>
                    <ComboBox x:Name="cboTxTypeDetail"  Margin="5"/>
                    <TextBlock Text="transaction date" FontWeight="Bold" Margin="5" Grid.Row="1"/>
                    <DatePicker x:Name="dtpTransactionDate" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
