<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <add key="TradingApiKey" value="ivBxNHvTMxudqbloVZzO1wKzO5xmWquvg_fpQMT0lmwk1tqtDP6YyVL_mEQLx-nx" />
    <add key="TradingApiBaseUrl" value="http://localhost:5001" />
    <add key="ProcessMonitorPrefixes" value="run_ticker_update,run_rawdata_update,run_benchmark_update,run_trade_live" />
    <!-- Auto-refresh interval (seconds) for the Ticker Freezer screen. 0 disables auto-refresh.
