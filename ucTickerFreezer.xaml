<UserControl x:Class="wpfTDX.ucTickerFreezer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="FreezeTemplate">
            <CheckBox IsChecked="{Binding Freeze, Mode=TwoWay}"
                  Command="{Binding DataContext.ToggleFreezeFundCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                  CommandParameter="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="2">
        
        <Border BorderBrush="Black" Background="LightPink" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                    <StackPanel Grid.Column="0">
                    <TextBlock Text="Freezer" HorizontalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="18"/>
                    
                        <!-- Controls aligned in a horizontal layout -->
                    <StackPanel Orientation="Horizontal" Margin="5">
                        
                            <Button 
                            x:Name="cmdRefresh" 
                            Content="Refresh"  
                            FontWeight="Bold" 
                            Command="{Binding RefreshCommand}"  
                            Width="100" 
                            Margin="0,0,5,0"
                            HorizontalAlignment="Left" />

                        <!-- Select All Checkbox -->
                        <CheckBox 
                            Content="Select All Override"
                            IsChecked="{Binding IsSelectAllChecked, Mode=TwoWay}"
                            Margin="0,0,5,0" />

                        <!-- Batch Thaw Button -->
                        <Button 
                            Content="Batch Override"
                            Command="{Binding BatchOverrideCommand}"
                            FontWeight="Bold"
                            Width="100"
                            HorizontalAlignment="Left" />


                        <!-- Select All Checkbox -->
                        <CheckBox 
                            Content="Select All Thaw"
                            IsChecked="{Binding IsSelectAllThawChecked, Mode=TwoWay}"
                            Margin="0,0,5,0" />

                        <Button 
                            Content="Batch Thaw"
                            Command="{Binding BatchThawCommand}"
                            FontWeight="Bold"
                            Width="100"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                    <Expander x:Name="ExpGeneralFreezer" Header="Ticker Freezer" IsExpanded="True">
                    <DataGrid x:Name="dgTickerFreezer" 
                              AutoGenerateColumns="False"
                                Height="500"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedTicker, Mode=TwoWay}"
                              PreviewMouseRightButtonDown="dgTickerFreezer_MouseRightButtonDown"
                              ItemsSource="{Binding TickerFreezer, Mode=TwoWay}"
                            IsReadOnly="False"   
                             
                                Margin="5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" />
                                <DataGridTextColumn Header="EMSName" Binding="{Binding Emsname}" />
                                <DataGridTextColumn Header="BrokerCodeExec" Binding="{Binding BrokerCodeExec}" />
                                <DataGridTextColumn Header="FundName" Binding="{Binding Fundname}" />
                                <DataGridTextColumn Header="SubaccountName" Binding="{Binding Subaccountname}" />
                                <DataGridTextColumn Header="ExecAccountName" Binding="{Binding Execaccountname}" />
                                <DataGridTextColumn Header="BenchmarkName" Binding="{Binding Benchmarkname}" />
                                <DataGridTextColumn Header="TadId" Binding="{Binding Tadid}" />
                                <DataGridTextColumn Header="TickerName" Binding="{Binding Tickername}" />
                                <DataGridCheckBoxColumn Header="Override"
                                 Binding="{Binding Override, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="ForceOverride"
                                 Binding="{Binding ForceOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridCheckBoxColumn Header="Thaw"
                                 Binding="{Binding Thaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="ErrorCode" Binding="{Binding Errorcode}" />
                                <DataGridTextColumn Header="Error" Binding="{Binding Errorstring}" />
                                <DataGridTextColumn Header="FreezeExpiration" Binding="{Binding FreezeExpiration}" />
                                <DataGridTextColumn Header="OverrideExpiration" Binding="{Binding OverrideExpiration}" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="thaw tad_id?" Command="{Binding ThawTadIdCommand}"></MenuItem>
                                <MenuItem Header="override tad_id?" Click="MenuItem_Click_1">
                                    <MenuItem Header="expire at close?" Command="{Binding OverrideTadIdAfterCloseCommand}"/>
                                    <MenuItem Header="no expiration?" Command="{Binding OverrideTadIdNeverCommand}"/>
                                </MenuItem>
                                <MenuItem Header="remove override for this tad_id?" Command="{Binding RemoveOverrideCommand}"/>
                                <MenuItem Header="search any tad_id to freeze?" Command="{Binding SearchTadIdCommand}" >
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    </Expander>

                    <Expander x:Name="ExpFunds" Header="Fund Freezer">
                        <DataGrid x:Name="dgFunds"
                              AutoGenerateColumns="True"
                                Height="500"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ItemsSource="{Binding FundsData, Mode=TwoWay}"
                                 SelectedItem="{Binding SelectedFund, Mode=TwoWay}" 
                                  AutoGeneratingColumn="dgFunds_AutoGeneratingColumn"
                             
                                Margin="5">

                        </DataGrid>
                    </Expander>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <Button
                        x:Name="cmdClose" Content="X" Click="cmdClose_Click"  
                        HorizontalAlignment="Right"
                        Width="25"
                        FontWeight="Bold"
                     />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
