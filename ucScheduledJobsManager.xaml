<UserControl x:Class="wpfTDX.ucScheduledJobsManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Margin="2">
        <TextBox x:Name="txtProcess" Visibility="Hidden"/>
        <!-- Top Section for Existing Jobs -->
        <Expander Header="Current Jobs" IsExpanded="True" FontWeight="Bold">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="2">
                        <DataGrid  x:Name="dgAllJobs"
                                  ItemsSource="{Binding ScheduledJobs, Mode=TwoWay}"
                                  SelectedItem="{Binding SelectedJob, Mode=TwoWay}" 
                                  AutoGenerateColumns="False" SelectionMode="Single">
                            <!-- Define Columns for Job List -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel  Grid.Column="1" Margin="2">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="5">
                        <Button x:Name="cmdClose" Width="15" Click="cmdClose_Click" Content="x" FontWeight="Bold" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <!-- Job Details Section -->
        <Expander Header="Add/Edit Job" IsExpanded="True" FontWeight="Bold">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- First Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Second Row -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="5" Text="Job Name" FontWeight="Bold"/>
                    <TextBox Grid.Column="1"  Margin="5" x:Name="txtJobName" Text="{Binding SelectedJob.JobName, Mode=TwoWay}"  Grid.Row="0" />

        <!-- Frequency -->
                    <TextBlock Grid.Column="2" Margin="5" Text="Frequency" FontWeight="Bold" Grid.Row="0"/>
                    <ComboBox Grid.Column="3" Margin="5" x:Name="cboFrequency"  Grid.Row="0"
                          ItemsSource="{Binding ScheduleFrequencies}"
                          DisplayMemberPath="FrequencyName" 
                          SelectedValuePath="FrequencyId" 
                          SelectedValue="{Binding SelectedJob.FrequencyId, Mode=TwoWay}" />


                    <TextBlock Grid.Column="4" Margin="5" Text="Days" FontWeight="Bold"  Grid.Row="0"/>
                    <ComboBox Grid.Column="5" Margin="5" x:Name="cboDays"   Grid.Row="0"
                              ItemsSource="{Binding ScheduleDays}"
                                DisplayMemberPath="DayName" 
                                SelectedValuePath="DayId" 
                                SelectedValue="{Binding SelectedJob.DayId, Mode=TwoWay}" />
                    <TextBlock Grid.Column="6" Margin="5" Text="Closing Time Delta" FontWeight="Bold" Grid.Row="0"/>
                    <TextBox Grid.Column="7" Margin="5" x:Name="txtClosingTimeDelta" Grid.Row="0"
                             Text="{Binding SelectedJob.GlobalClosingDeltaMinutes}" />

                    <!-- Python Module and Class -->
                <TextBlock Grid.Column="0" Margin="5" Text="Python Module" FontWeight="Bold" Grid.Row="1" />
                <TextBox Grid.Column="1" Margin="5" Text="{Binding SelectedJob.PythonModule, Mode=TwoWay}" Grid.Row="1" />

                <TextBlock Grid.Column="2" Margin="5" Text="Python Class" FontWeight="Bold"  Grid.Row="1" />
                <TextBox Grid.Column="3" Margin="5" Text="{Binding SelectedJob.PythonClass, Mode=TwoWay}"   Grid.Row="1"/>

                <!-- Method and Backfill -->
                <TextBlock Grid.Column="4" Margin="5" Text="Execute Method" FontWeight="Bold"  Grid.Row="1"/>
                <TextBox Grid.Column="5" Margin="5" Text="{Binding SelectedJob.ExecuteMethod, Mode=TwoWay}"  Grid.Row="1"/>

                <TextBlock Grid.Column="6" Margin="5" Text="Backfill" FontWeight="Bold"  Grid.Row="1"/>
                <ComboBox Grid.Column="7" Margin="5" ItemsSource="{Binding TrueFalseOptions}" 
                            SelectedItem="{Binding SelectedJob.BackFill, Mode=TwoWay}"  Grid.Row="1"/>
                </Grid>
            </Border>
        </Expander>

        <!-- Job Parameters Section -->
        <Expander Header="Configure Job Parameters" IsExpanded="False" FontWeight="Bold">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding JobParameters}" 
                              AutoGenerateColumns="False" 
                              SelectedItem="{Binding SelectedJobParameter, Mode=TwoWay}"
                              CanUserAddRows="True">
                        <!-- Define the columns based on the properties of JobParametersDataModel -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParameterName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add Parameter Button -->
                    <Button 
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Margin="2" 
                        Content="Add Parameter" 
                        Width="100"
                        Height="20"
                        Command="{Binding AddParameterCommand}"
                        HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </Expander>
        <Expander Header="Configure Job Parameter Values" IsExpanded="False" FontWeight="Bold">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="2" >
                        <DataGrid ItemsSource="{Binding JobParameterValues}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Binding="{Binding ParameterValue}" />
                                <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" />
                                <!-- Add this column -->
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="2">
                        <Button 
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Margin="2" 
                        Content="Add Parameter Value" 
                        Width="130"
                        Height="20"
                        Command="{Binding AddParameterValueCommand}"
                        HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>

