<UserControl x:Class="wpfTDX.ucScheduledJobsManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="2" >

        <Border BorderBrush="Black" Background="White"  BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>
                <StackPanel Margin="2">
                    <DataGrid  x:Name="dgAllJobs"
                            
                            ItemsSource="{Binding ScheduledJobs,Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                <Button x:Name="cmdClose"
                        Width="15"
                        Click="cmdClose_Click" Content="x"  FontWeight="Bold" />
            </StackPanel>
            </Grid>
        </Border>
        <Border  BorderBrush="Black" Background="White"  BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Job Name" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
