<UserControl x:Class="wpfTDX.ucScheduledJobsManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" d:DesignHeight="820" Width="1180">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Margin="8">

        <!-- toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Scheduled Jobs" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,3" Margin="16,0,0,0"/>
            <ProgressBar Width="120" Height="14" IsIndeterminate="True" VerticalAlignment="Center" Margin="16,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- JOB LIST -->
                <GroupBox Header="Current jobs" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="id"        Binding="{Binding JobId}" Width="40"/>
                            <DataGridTextColumn Header="job"       Binding="{Binding JobName}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="on"    Binding="{Binding Enabled}" Width="40"/>
                            <DataGridCheckBoxColumn Header="backfill" Binding="{Binding Backfill}" Width="Auto"/>
                            <DataGridTextColumn Header="freq"      Binding="{Binding FreqName}" Width="Auto"/>
                            <DataGridTextColumn Header="day"       Binding="{Binding DayName}" Width="Auto"/>
                            <DataGridTextColumn Header="next run"  Binding="{Binding NextRuntime}" Width="Auto"/>
                            <DataGridTextColumn Header="last run"  Binding="{Binding LastRuntime}" Width="Auto"/>
                            <DataGridTextColumn Header="status"    Binding="{Binding LastStatus}" Width="Auto"/>
                            <DataGridTextColumn Header="class"     Binding="{Binding PythonClass}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- EDIT SELECTED -->
                <GroupBox Header="Edit selected job" Margin="0,0,0,8">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="4" Text="{Binding SelectedJob.JobName}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Module" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="4" Text="{Binding SelectedJob.PythonModule}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Enabled" Margin="4" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="0" Grid.Column="5" Margin="4" VerticalAlignment="Center" IsChecked="{Binding SelectedJob.Enabled}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Class" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding SelectedJob.PythonClass}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Method" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="4" Text="{Binding SelectedJob.ExecuteMethod}"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Backfill" Margin="4" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="1" Grid.Column="5" Margin="4" VerticalAlignment="Center" IsChecked="{Binding SelectedJob.Backfill}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency" Margin="4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="4" ItemsSource="{Binding Frequencies}"
                                  DisplayMemberPath="FreqName" SelectedValuePath="FreqId"
                                  SelectedValue="{Binding SelectedJob.FreqId}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Day" Margin="4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="3" Margin="4" ItemsSource="{Binding Days}"
                                  DisplayMemberPath="DayName" SelectedValuePath="DayId"
                                  SelectedValue="{Binding SelectedJob.DayId}"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="GC delta" Margin="4" VerticalAlignment="Center"
                                   ToolTip="Delta in minutes relative to the global closing time (business mode only)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbEditDayMode}" Value="calendar">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="5" Margin="4" Text="{Binding SelectedJob.GlobalClosingDeltaMinutes}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbEditDayMode}" Value="calendar">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Day mode" Margin="4" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbEditDayMode" Grid.Row="3" Grid.Column="1" Margin="4"
                                  ItemsSource="{Binding DayModes}" SelectedItem="{Binding SelectedJob.DayMode}"
                                  ToolTip="business = time relative to market close (GC delta), business days only. calendar = fixed UTC time, runs every calendar day incl. weekends."/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Run time (UTC)" Margin="4" VerticalAlignment="Center"
                                   ToolTip="Fixed UTC time. During British Summer Time the local clock time shifts by an hour (this time floats in local terms).">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbEditDayMode}" Value="calendar">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="3" Grid.Column="3" Margin="4"
                                  ItemsSource="{Binding HalfHourTimes}" SelectedItem="{Binding SelectedJob.RunTimeUtc}"
                                  ToolTip="Fixed UTC time. During BST the local clock time shifts by an hour.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbEditDayMode}" Value="calendar">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- PARAMETERS OF SELECTED JOB (editable; synced on "Update job") -->
                <GroupBox Header="Parameters (selected job)" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Edit / add / delete rows, then click &quot;Update job&quot; to save. (Del removes a row.)"
                                   Margin="4,2,4,4" Foreground="Gray" FontSize="11"/>
                        <DataGrid ItemsSource="{Binding SelectedJob.Parameters}" AutoGenerateColumns="False"
                                  IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                  HeadersVisibility="Column" MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="param_name"  Binding="{Binding ParamName}"  Width="*"/>
                                <DataGridTextColumn Header="param_value" Binding="{Binding ParamValue}" Width="*"/>
                                <DataGridTextColumn Header="environment" Binding="{Binding Environment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                    <TextBlock Text="Force-run date (optional):" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Leave blank to run now. Set a date to run the job for that for_date (date-driven jobs)."/>
                    <DatePicker SelectedDate="{Binding ForceRunDate}" Width="130" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Force run" Command="{Binding ForceRunCommand}" Padding="14,4" Margin="0,0,16,0"
                            ToolTip="Run the selected job now (in the API process). Refresh afterwards to see its status."/>
                    <Button Content="Update job" Command="{Binding UpdateCommand}" Padding="14,4" Margin="0,0,8,0"/>
                    <Button Content="Delete job" Command="{Binding DeleteCommand}" Padding="14,4"/>
                </StackPanel>

                <!-- NEW JOB -->
                <GroupBox Header="New job">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="4" Text="{Binding NewJob.JobName}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Module" Margin="4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="4" Text="{Binding NewJob.PythonModule}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Enabled" Margin="4" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="0" Grid.Column="5" Margin="4" VerticalAlignment="Center" IsChecked="{Binding NewJob.Enabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Class" Margin="4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding NewJob.PythonClass}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Method" Margin="4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Margin="4" Text="{Binding NewJob.ExecuteMethod}"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Backfill" Margin="4" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="1" Grid.Column="5" Margin="4" VerticalAlignment="Center" IsChecked="{Binding NewJob.Backfill}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency" Margin="4" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="4" ItemsSource="{Binding Frequencies}"
                                      DisplayMemberPath="FreqName" SelectedValuePath="FreqId"
                                      SelectedValue="{Binding NewJob.FreqId}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Day" Margin="4" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="4" ItemsSource="{Binding Days}"
                                      DisplayMemberPath="DayName" SelectedValuePath="DayId"
                                      SelectedValue="{Binding NewJob.DayId}"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="GC delta" Margin="4" VerticalAlignment="Center"
                                   ToolTip="Delta in minutes relative to the global closing time (business mode only)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbNewDayMode}" Value="calendar">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Row="2" Grid.Column="5" Margin="4" Text="{Binding NewJob.GlobalClosingDeltaMinutes}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbNewDayMode}" Value="calendar">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Day mode" Margin="4" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbNewDayMode" Grid.Row="3" Grid.Column="1" Margin="4"
                                      ItemsSource="{Binding DayModes}" SelectedItem="{Binding NewJob.DayMode}"
                                      ToolTip="business = time relative to market close (GC delta), business days only. calendar = fixed UTC time, runs every calendar day incl. weekends."/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Run time (UTC)" Margin="4" VerticalAlignment="Center"
                                       ToolTip="Fixed UTC time. During British Summer Time the local clock time shifts by an hour (this time floats in local terms).">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbNewDayMode}" Value="calendar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Grid.Row="3" Grid.Column="3" Margin="4"
                                      ItemsSource="{Binding HalfHourTimes}" SelectedItem="{Binding NewJob.RunTimeUtc}"
                                      ToolTip="Fixed UTC time. During BST the local clock time shifts by an hour.">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=cmbNewDayMode}" Value="calendar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Start from" Margin="4" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="4" Grid.Column="1" Margin="4" SelectedDate="{Binding NewJobStartFrom}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="4" Margin="4" Foreground="#777"
                                       Text="(first-run anchor — backfill jobs run from this date; others first fire at/after it)"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Parameters (one row per value; group by name)" FontWeight="Bold" Margin="4,10,4,2"/>
                        <DataGrid ItemsSource="{Binding NewParams}" AutoGenerateColumns="False"
                                  CanUserAddRows="True" MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="param_name"  Binding="{Binding ParamName}"  Width="*"/>
                                <DataGridTextColumn Header="param_value" Binding="{Binding ParamValue}" Width="*"/>
                                <DataGridTextColumn Header="environment" Binding="{Binding Environment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Clear" Command="{Binding ClearNewCommand}" Padding="14,4" Margin="0,0,8,0"/>
                            <Button Content="Create job" Command="{Binding CreateCommand}" Padding="14,4"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
