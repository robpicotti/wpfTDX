<UserControl x:Class="wpfTDX.ucOrdersArchive"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Border BorderBrush="Black" Background="SeaShell" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width ="3*"/>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions >

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="fundname" FontWeight="Bold" Margin="5"/>
                    <ComboBox x:Name="cboFundName" SelectionChanged="cboFundName_SelectionChanged" Margin="5">
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="subaccount" FontWeight="Bold" Margin="5"/>
                    <ComboBox x:Name="cboSubaccountName" Margin="5">
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="start date" FontWeight="Bold" Margin="5" />
                    <DatePicker x:Name="dtpFromDate" Margin="5"></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="end date" FontWeight="Bold" Margin="5" />
                    <DatePicker x:Name="dtpEndDate"  Margin="5"></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="5">
                    <RadioButton x:Name="rbViewOrders" Click="rbViewOrders_Click" Margin="5 25 5 2" 
                                 Content="view orders" FontWeight="Bold" >
                    </RadioButton>
                    <RadioButton x:Name="rbViewOrdersArchive" Click="rbViewOrdersArchive_Click" 
                                 Content="view orders archive"
                                 FontWeight="Bold"
                                 Margin="5"></RadioButton>
                </StackPanel>
 
            </Grid>

        </Border>
        <TextBlock Text="Orders Archive" Margin="5" FontWeight="Bold" FontSize="15"/>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width ="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtbOrders" Margin="5" FontWeight="Bold"  />
                        <DataGrid x:Name="dgOrders" Margin="5" Height="200"        
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                           >
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <StackPanel Grid.Column="1">
                    
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width ="*"/>
                                <ColumnDefinition Width ="*"/>
                                <ColumnDefinition Width ="*"/>
                                <ColumnDefinition Width ="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="tad_order_id" Margin="5" FontWeight="Bold"/>
                                <TextBox x:Name="txtTOID" Margin="5" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="tad_id" Margin="5" FontWeight="Bold"/>
                                <TextBox x:Name="txtTadId" Margin="5" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="submit_time" Margin="5" FontWeight="Bold"/>
                                <TextBox x:Name="txtOrdSubmitTime" Margin="5" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="action" Margin="5" FontWeight="Bold" />
                                <TextBox x:Name="txtACtion" Margin="5" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="status" Margin="5" FontWeight="Bold"/>
                                <TextBox x:Name="txtStatus" Margin="5" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <CheckBox x:Name="chkFullOrderFlow" FontWeight="Bold" Content="archive full order flow" Margin="5">
                            </CheckBox>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="chkDeleteTransactions" FontWeight="Bold" Content="only delete transactions" Margin="5"></CheckBox>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="chkDelTxAndEx" FontWeight="Bold" Content="delete transactions and executions" Margin="5"></CheckBox>
                        </StackPanel>
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width ="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Button x:Name="cmdProcess" Content="Process" 
                                        Width="100" HorizontalAlignment="Left"
                                        FontWeight="Bold" Margin="5" Click="cmdProcess_Click">
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                
                </StackPanel>
                    
            </Grid>

        </Border>
    </StackPanel>

</UserControl>
