<UserControl x:Class="wpfTDX.ucEMS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <StackPanel Margin="2">
        <Border BorderBrush="Black" Background="DarkSeaGreen"  BorderThickness="1" Padding="5" Margin="5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="fundname:" FontWeight="Bold" Margin="5 1" />
                    <ComboBox x:Name="cboFundname" IsReadOnly="True" Margin="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="from:" FontWeight="Bold" Margin="5 1" />
                    <DatePicker x:Name="dtPickerFrom" Margin="5"></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="to:" FontWeight="Bold" Margin="5 1" />
                    <DatePicker x:Name="dtPickerTo" Margin="5"></DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="5 23">
                    <Button x:Name="cmdRun" Click="cmdRun_Click"  Content="Run" Background="LightGray" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <Button x:Name="cmdClose" Click="cmdClose_Click" Content="X"  FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Text="EMS" FontWeight="Bold" Margin="5"/>
        <Border BorderBrush="Black" BorderThickness="1" Padding="5" Margin="5">
            <TabControl>
                <TabItem Header="Open Orders" x:Name="tabiOpenOrders">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button 
                                x:Name="btnSelectAll"
                                Background="LightGreen"
                                Content="Select All"
                                Click="btnSelectAll_Click"
                                HorizontalAlignment="Left"
                                Width="115"
                                Margin="2"
                                FontWeight="Bold"
                                Visibility="Hidden">
                            </Button>
                            <Button 
                                x:Name="btnFreeze" 
                                Content="Freeze" 
                                Click="btnFreeze_Click"
                                Width="100" 
                                HorizontalAlignment="Left" 
                                Margin="2" 
                                FontWeight="Bold"
                                Visibility="Hidden">
                            </Button>
                            <Button 
                                x:Name="btnCancel" 
                                Content="Cancel" 
                                Click="btnCancel_Click"
                                Width="100" 
                                HorizontalAlignment="Left" 
                                Margin="2" 
                                FontWeight="Bold"
                                Visibility="Hidden">
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="dgOpenOrders" AutoGenerateColumns="True"
                                Height="200"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="false"
                                CanUserAddRows="False"
                                Margin="5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                        </DataGrid>
                    </StackPanel>
                </TabItem>


                <TabItem Header="Proposed Open Orders" x:Name="tabiOpenOrdersProposed">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button 
                                x:Name="btnApproveAll"
                                Background="LightGreen"
                                Content="Select All"
                                Click="btnApproveAll_Click"
                                HorizontalAlignment="Left"
                                Width="115"
                                Margin="2"
                                FontWeight="Bold"
                                Visibility="Hidden">
                            </Button>
                            <Button 
                                x:Name="btnApprove" 
                                Content="Approve" 
                                Click="btnApprove_Click" 
                                Width="100" 
                                HorizontalAlignment="Left" 
                                Margin="2" 
                                FontWeight="Bold"
                                Visibility="Hidden">
                            </Button>
                        </StackPanel>



                        <DataGrid x:Name="dgOpenOrdersProposed" AutoGenerateColumns="True"
                                Height="200"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="false"
                                CanUserAddRows="False"
                                Margin="5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Filled Orders" x:Name="tabiOrders" Height="22" VerticalAlignment="Top">
                    <StackPanel>
                        <DataGrid x:Name="dgOrders" AutoGenerateColumns="True"
                                Height="200"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Margin="5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Executions" x:Name="tabiExecutions">
                    <StackPanel>
                        <DataGrid x:Name="dgExecutions" AutoGenerateColumns="True"
                                Height="500"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Margin="5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Transactions" x:Name="tabiTransactions">
                    <StackPanel>
                        <DataGrid x:Name="dgTransactions" AutoGenerateColumns="True"
                                Height="500"       
                                ScrollViewer.CanContentScroll="True" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Margin="5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </StackPanel>
</UserControl>
