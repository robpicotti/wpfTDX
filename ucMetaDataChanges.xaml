<UserControl x:Class="wpfTDX.ucMetaDataChanges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfTDX"
             mc:Ignorable="d" 
             Loaded="Window_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:DataTableNotEmptyToVisibilityConverter x:Key="DataTableNotEmptyToVisibilityConverter"/>
    </UserControl.Resources>

<StackPanel>
        <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}"></Button>
                <Button Grid.Column="4" Content="x" Width="20" Click="Button_Click" HorizontalAlignment="Right"></Button>
            </Grid>
        </Border>
        <Expander x:Name="ExpMetadata" Header="Tables meta data" Visibility="{Binding TablesMetadataTable, Converter={StaticResource DataTableNotEmptyToVisibilityConverter}}">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <Grid>
                <DataGrid x:Name="dgMetadata" ItemsSource="{Binding TablesMetadataTable}" AutoGenerateColumns="True">
                </DataGrid>
            </Grid>
        </Border>
        </Expander>
        <Expander x:Name="ExpFilter" Header="Portfolio filters" Visibility="{Binding FiltersTable, Converter={StaticResource DataTableNotEmptyToVisibilityConverter}}">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <DataGrid x:Name="dgPortfolioFilters" ItemsSource="{Binding FiltersTable}" AutoGenerateColumns="True"></DataGrid>
            </Border>
        </Expander>
        <Expander x:Name="ExpPortfolioWeights" Header="Portfolio weights" Visibility="{Binding WeightsTable, Converter={StaticResource DataTableNotEmptyToVisibilityConverter}}">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <DataGrid x:Name="dgPortfolioWeights" ItemsSource="{Binding WeightsTable}" AutoGenerateColumns="True"></DataGrid>
            </Border>
        </Expander>
        <Expander x:Name="ExpAllocation" Header="Portfolio allocations" Visibility="{Binding AllocationsTable, Converter={StaticResource DataTableNotEmptyToVisibilityConverter}}">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <DataGrid x:Name="dgPortfolioAllocations" ItemsSource="{Binding AllocationsTable}" AutoGenerateColumns="True"></DataGrid>
            </Border>
        </Expander>
        <Expander x:Name="ExpBenchmarks" Header="Benchmarks" Visibility="{Binding BenchmarksTable, Converter={StaticResource DataTableNotEmptyToVisibilityConverter}}">
            <Border BorderBrush="Black" Background="White" BorderThickness="1" Padding="5" Margin="5">
                <DataGrid x:Name="dgBenchmarks" ItemsSource="{Binding AllocationsTable}" AutoGenerateColumns="True"></DataGrid>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
